# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Where audio files live (local-disk dev storage, relative to the backend folder).
STORAGE_DIR=storage

DATABASE_URL=postgres://spotmusic:spotmusic@localhost:5432/spotmusic

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# Comma-separated list of allowed web origins (empty = no browser CORS)
CORS_ORIGINS=

# Social sign-in. Leave empty to disable the provider (endpoint returns 501).
# Google: OAuth client IDs of your Android, iOS and web clients.
GOOGLE_CLIENT_IDS=
# Apple: your App ID bundle identifier(s) and/or Services ID.
APPLE_CLIENT_IDS=

# Password-reset email. Without SMTP_URL the link is only logged, and only in development.
# Example: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=SpotMusic <no-reply@example.com>
# Deep link or web page that opens the reset screen; the token is appended as ?token=
PASSWORD_RESET_URL=spotmusic://reset-password
